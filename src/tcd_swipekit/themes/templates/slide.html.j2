<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
{{ font_css | safe }}

:root {
  --w: {{ width }}px;
  --h: {{ height }}px;
  --scale: {{ scale }};
  --bg: {{ theme.bg_color }};
  --text: {{ theme.text_color }};
  --muted: {{ theme.muted_color }};
  --subtle: {{ theme.subtle_color }};
  --divider: {{ theme.divider_color }};
  --accent: {{ theme.accent_color }};
  --pill-accent-bg: {{ theme.pill_accent_bg }};
  --pill-accent-text: {{ theme.pill_accent_text }};
  --pill-glass-bg: {{ theme.pill_glass_bg }};
  --pill-glass-border: {{ theme.pill_glass_border }};
  --cli-bg: {{ theme.cli_bg }};
  --cli-border: {{ theme.cli_border }};
  --cli-text: {{ theme.cli_text }};
  --radius: {{ theme.card_radius }}px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  width: var(--w);
  height: var(--h);
  overflow: hidden;
  background: var(--bg);
  font-family: '{{ theme.font_body }}', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  color: var(--text);
}

.canvas {
  position: relative;
  width: var(--w);
  height: var(--h);
  background: var(--bg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: calc(84px * var(--scale)) calc(84px * var(--scale)) calc(74px * var(--scale)) calc(84px * var(--scale));
}

.ambient-bg {
  position: absolute;
  inset: -120px;
  background-image: url("{{ image_uri }}");
  background-size: cover;
  background-position: center;
  filter: blur(110px) saturate({{ theme.ambient_saturation }}) brightness({{ theme.ambient_brightness }});
  transform: scale(1.18);
  z-index: 0;
}

.ambient-overlay {
  position: absolute;
  inset: 0;
  background: radial-gradient(
    circle at 50% 48%,
    rgba(10, 12, 16, 0.16) 0%,
    {{ ambient_tint }} 78%,
    rgba(6, 7, 10, 0.92) 100%
  );
  z-index: 1;
}

.inner {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.top-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: calc(34px * var(--scale));
}

.num-group {
  display: flex;
  align-items: baseline;
  gap: calc(10px * var(--scale));
}

.num {
  font-family: '{{ theme.font_heading }}', sans-serif;
  font-size: calc(112px * var(--scale));
  font-weight: 800;
  line-height: 0.92;
  letter-spacing: -0.04em;
  color: var(--text);
}

.num-total {
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(30px * var(--scale));
  font-weight: 600;
  color: var(--subtle);
}

.progress-track {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: calc(7px * var(--scale));
  background: var(--divider);
  z-index: 25;
}

.progress-fill {
  height: 100%;
  width: {{ progress_percent }}%;
  background: var(--accent);
}

.divider {
  width: 100%;
  height: 2px;
  background: var(--divider);
  margin-bottom: calc(36px * var(--scale));
}

.eyebrow {
  font-size: calc(36px * var(--scale));
  font-weight: 400;
  color: var(--subtle);
  letter-spacing: -0.01em;
  margin-bottom: calc(8px * var(--scale));
}

.title {
  font-family: '{{ theme.font_heading }}', sans-serif;
  font-size: calc({{ title_size }}px * var(--scale));
  font-weight: 800;
  line-height: 1.02;
  letter-spacing: -0.04em;
  color: var(--text);
  margin-bottom: calc(24px * var(--scale));
  word-break: break-word;
}

.desc {
  font-size: calc(34px * var(--scale));
  font-weight: 400;
  line-height: 1.38;
  color: var(--muted);
  letter-spacing: -0.01em;
  max-width: 98%;
}

.visual-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: calc(26px * var(--scale)) 0 calc(28px * var(--scale)) 0;
  min-height: 0;
}

.shot {
  max-width: 100%;
  max-height: {{ max_shot_height }}px;
  width: auto;
  height: auto;
  border-radius: var(--radius);
  box-shadow: {{ '0 26px 68px rgba(0, 0, 0, 0.56), 0 0 0 1px rgba(255, 255, 255, 0.10)' if not theme.is_light else '0 20px 50px rgba(17, 18, 20, 0.14), 0 0 0 1px rgba(17, 18, 20, 0.08)' }};
  object-fit: {{ item.image_fit }};
  display: block;
}

.frame-window {
  max-width: 100%;
  border-radius: var(--radius);
  overflow: hidden;
  background: {{ '#11141B' if not theme.is_light else '#FFFFFF' }};
  border: 1.5px solid {{ 'rgba(255, 255, 255, 0.14)' if not theme.is_light else 'rgba(17, 18, 20, 0.14)' }};
  box-shadow: {{ '0 28px 70px rgba(0, 0, 0, 0.58)' if not theme.is_light else '0 22px 54px rgba(17, 18, 20, 0.14)' }};
  display: flex;
  flex-direction: column;
}

.frame-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(16px * var(--scale));
  padding: calc(14px * var(--scale)) calc(22px * var(--scale));
  background: {{ 'rgba(255, 255, 255, 0.05)' if not theme.is_light else '#F1F5F9' }};
  border-bottom: 1px solid {{ 'rgba(255, 255, 255, 0.10)' if not theme.is_light else 'rgba(15, 23, 42, 0.10)' }};
}

.frame-dots {
  display: flex;
  align-items: center;
  gap: calc(9px * var(--scale));
  flex-shrink: 0;
}

.fdot {
  width: calc(13px * var(--scale));
  height: calc(13px * var(--scale));
  border-radius: 999px;
}
.fdot-r { background: #FF5F56; }
.fdot-y { background: #FFBD2E; }
.fdot-g { background: #27C93F; }

.frame-url-pill {
  flex: 1;
  max-width: 72%;
  margin: 0 auto;
  padding: calc(7px * var(--scale)) calc(18px * var(--scale));
  border-radius: 999px;
  background: {{ 'rgba(0, 0, 0, 0.36)' if not theme.is_light else '#FFFFFF' }};
  border: 1px solid {{ 'rgba(255, 255, 255, 0.10)' if not theme.is_light else 'rgba(15, 23, 42, 0.10)' }};
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(18px * var(--scale));
  font-weight: 500;
  color: var(--muted);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.frame-title {
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(19px * var(--scale));
  font-weight: 600;
  color: var(--muted);
  margin: 0 auto;
}

.shot.in-frame {
  border-radius: 0;
  box-shadow: none;
  max-height: {{ (max_shot_height - 46) | int }}px;
  width: 100%;
}

.shot-placeholder {
  width: 100%;
  height: {{ (max_shot_height * 0.72) | int }}px;
  border-radius: var(--radius);
  background: linear-gradient(135deg, {{ theme.accent_color }}22, rgba(255, 255, 255, 0.04));
  border: 1.5px solid var(--divider);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  padding: 40px;
  text-align: center;
}

.shot-placeholder-title {
  font-size: calc(44px * var(--scale));
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--text);
}

.shot-placeholder-sub {
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(24px * var(--scale));
  color: var(--subtle);
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: calc(22px * var(--scale));
}

.pills {
  display: flex;
  align-items: center;
  gap: calc(16px * var(--scale));
  flex-wrap: wrap;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: calc(72px * var(--scale));
  padding: 0 calc(32px * var(--scale));
  border-radius: 999px;
  font-size: calc(28px * var(--scale));
  font-weight: 600;
  letter-spacing: -0.01em;
  white-space: nowrap;
}

.pill-glass {
  background: var(--pill-glass-bg);
  border: 1.5px solid var(--pill-glass-border);
  color: var(--text);
  backdrop-filter: blur(12px);
}

.pill-accent {
  background: var(--pill-accent-bg);
  color: var(--pill-accent-text);
  font-weight: 700;
  padding: 0 calc(36px * var(--scale));
  box-shadow: 0 8px 24px {{ theme.pill_accent_bg }}40;
}

.cli-pill {
  display: inline-flex;
  align-items: center;
  background: var(--cli-bg);
  border: 1.5px solid var(--cli-border);
  border-radius: 999px;
  padding: calc(18px * var(--scale)) calc(34px * var(--scale));
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(24px * var(--scale));
  font-weight: 500;
  color: var(--cli-text);
  letter-spacing: -0.02em;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.micro-note {
  font-size: calc(21px * var(--scale));
  font-weight: 700;
  letter-spacing: 0.085em;
  text-transform: uppercase;
  padding-left: 6px;
  color: {{ theme.accent_color if item.footnote_accent else theme.subtle_color }};
}

.watermark {
  position: absolute;
  z-index: 20;
  font-size: calc(24px * var(--scale));
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--subtle);
}
.wm-bottom-right { right: calc(84px * var(--scale)); bottom: calc(74px * var(--scale)); }
.wm-top-right { right: calc(84px * var(--scale)); top: calc(92px * var(--scale)); }
.wm-bottom-left { left: calc(84px * var(--scale)); bottom: calc(24px * var(--scale)); }
</style>
</head>
<body>
  <div class="canvas">
    {% if theme.show_progress and total_items > 1 %}
      <div class="progress-track"><div class="progress-fill"></div></div>
    {% endif %}
    {% if theme.ambient_blur and image_uri and not theme.is_light %}
      <div class="ambient-bg"></div>
      <div class="ambient-overlay"></div>
    {% endif %}

    <div class="inner">
      <div class="top-bar">
        <div class="num-group">
          <div class="num">{{ slide_number }}</div>
          {% if theme.show_progress and total_items > 1 %}
            <div class="num-total">/ {{ total_items_str }}</div>
          {% endif %}
        </div>
      </div>
      <div class="divider"></div>
      {% if item.eyebrow %}
        <div class="eyebrow">{{ item.eyebrow }}</div>
      {% endif %}
      <div class="title">{{ item.title }}</div>
      {% if item.description %}
        <div class="desc">{{ item.description }}</div>
      {% endif %}

      <div class="visual-wrap">
        {% if image_uri %}
          {% if item.frame and item.frame.value == 'browser' %}
            <div class="frame-window">
              <div class="frame-bar">
                <div class="frame-dots">
                  <span class="fdot fdot-r"></span>
                  <span class="fdot fdot-y"></span>
                  <span class="fdot fdot-g"></span>
                </div>
                <div class="frame-url-pill">🔒 {{ item.url or item.eyebrow or item.title }}</div>
                <div style="width: 36px;"></div>
              </div>
              <img class="shot in-frame" src="{{ image_uri }}" alt="{{ item.title }}" />
            </div>
          {% elif item.frame and item.frame.value == 'macos' %}
            <div class="frame-window">
              <div class="frame-bar">
                <div class="frame-dots">
                  <span class="fdot fdot-r"></span>
                  <span class="fdot fdot-y"></span>
                  <span class="fdot fdot-g"></span>
                </div>
                <div class="frame-title">{{ item.title }}</div>
                <div style="width: 36px;"></div>
              </div>
              <img class="shot in-frame" src="{{ image_uri }}" alt="{{ item.title }}" />
            </div>
          {% else %}
            <img class="shot" src="{{ image_uri }}" alt="{{ item.title }}" />
          {% endif %}
        {% else %}
          <div class="shot-placeholder">
            <div class="shot-placeholder-title">{{ item.title }}</div>
            {% if item.url %}
              <div class="shot-placeholder-sub">{{ item.url }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="footer">
        {% if item.badges %}
        <div class="pills">
          {% for badge in item.badges %}
            <div class="pill pill-{{ badge.style.value }}">{{ badge.text }}</div>
          {% endfor %}
        </div>
        {% endif %}

        {% if item.command_or_url %}
          <div class="cli-pill">{{ item.command_or_url }}</div>
        {% endif %}

        {% if item.footnote %}
          <div class="micro-note">{{ item.footnote }}</div>
        {% endif %}
      </div>
    </div>

    {% if theme.watermark %}
      <div class="watermark wm-{{ theme.watermark_position.value }}">{{ theme.watermark }}</div>
    {% endif %}
  </div>
</body>
</html>
