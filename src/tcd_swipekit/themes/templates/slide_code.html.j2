<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
{{ font_css | safe }}

:root {
  --w: {{ width }}px;
  --h: {{ height }}px;
  --scale: {{ scale }};
  --bg: {{ theme.bg_color }};
  --text: {{ theme.text_color }};
  --muted: {{ theme.muted_color }};
  --subtle: {{ theme.subtle_color }};
  --divider: {{ theme.divider_color }};
  --accent: {{ theme.accent_color }};
  --pill-accent-bg: {{ theme.pill_accent_bg }};
  --pill-accent-text: {{ theme.pill_accent_text }};
  --pill-glass-bg: {{ theme.pill_glass_bg }};
  --pill-glass-border: {{ theme.pill_glass_border }};
  --cli-bg: {{ theme.cli_bg }};
  --cli-border: {{ theme.cli_border }};
  --cli-text: {{ theme.cli_text }};
  --radius: {{ theme.card_radius }}px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  width: var(--w);
  height: var(--h);
  overflow: hidden;
  background: var(--bg);
  font-family: '{{ theme.font_body }}', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
  color: var(--text);
}

.canvas {
  position: relative;
  width: var(--w);
  height: var(--h);
  background: var(--bg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: calc(80px * var(--scale)) calc(84px * var(--scale)) calc(74px * var(--scale)) calc(84px * var(--scale));
}

.ambient-glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 82% 14%, {{ theme.accent_color }}{{ '26' if not theme.is_light else '18' }} 0%, transparent 46%),
    radial-gradient(circle at 18% 82%, {{ theme.pill_accent_bg }}{{ '1F' if not theme.is_light else '12' }} 0%, transparent 50%);
  z-index: 0;
}

.inner {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.top-bar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: calc(32px * var(--scale));
}

.num {
  font-family: '{{ theme.font_heading }}', sans-serif;
  font-size: calc(108px * var(--scale));
  font-weight: 800;
  line-height: 0.92;
  letter-spacing: -0.04em;
  color: var(--text);
}

.layout-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(22px * var(--scale));
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: calc(12px * var(--scale)) calc(24px * var(--scale));
  border-radius: 999px;
  background: var(--pill-glass-bg);
  border: 1.5px solid var(--pill-glass-border);
  color: var(--accent);
}

.divider {
  width: 100%;
  height: 2px;
  background: var(--divider);
  margin-bottom: calc(32px * var(--scale));
}

.eyebrow {
  font-size: calc(32px * var(--scale));
  font-weight: 500;
  color: var(--subtle);
  letter-spacing: -0.01em;
  margin-bottom: calc(8px * var(--scale));
}

.title {
  font-family: '{{ theme.font_heading }}', sans-serif;
  font-size: calc({{ title_size }}px * var(--scale));
  font-weight: 800;
  line-height: 1.03;
  letter-spacing: -0.04em;
  color: var(--text);
  margin-bottom: calc(20px * var(--scale));
  word-break: break-word;
}

.desc {
  font-size: calc(32px * var(--scale));
  font-weight: 400;
  line-height: 1.38;
  color: var(--muted);
  letter-spacing: -0.01em;
  max-width: 98%;
}

.code-stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: calc(28px * var(--scale)) 0;
  min-height: 0;
}

.code-window {
  width: 100%;
  border-radius: var(--radius);
  overflow: hidden;
  background: {{ '#0E1117' if not theme.is_light else '#111318' }};
  border: 1.5px solid {{ 'rgba(255, 255, 255, 0.14)' if not theme.is_light else 'rgba(17, 18, 20, 0.16)' }};
  box-shadow: {{ '0 28px 70px rgba(0, 0, 0, 0.58)' if not theme.is_light else '0 22px 54px rgba(17, 18, 20, 0.18)' }};
  display: flex;
  flex-direction: column;
}

.window-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(18px * var(--scale)) calc(26px * var(--scale));
  background: rgba(255, 255, 255, 0.04);
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
}

.window-dots {
  display: flex;
  align-items: center;
  gap: calc(10px * var(--scale));
}

.wdot {
  width: calc(14px * var(--scale));
  height: calc(14px * var(--scale));
  border-radius: 999px;
}
.wdot-r { background: #FF5F56; }
.wdot-y { background: #FFBD2E; }
.wdot-g { background: #27C93F; }

.window-filename {
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(22px * var(--scale));
  font-weight: 600;
  color: rgba(244, 244, 245, 0.85);
  letter-spacing: -0.01em;
}

.window-lang {
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(18px * var(--scale));
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: {{ theme.accent_color }};
  background: {{ theme.accent_color }}1E;
  border: 1px solid {{ theme.accent_color }}44;
  padding: calc(5px * var(--scale)) calc(14px * var(--scale));
  border-radius: 999px;
}

.code-body {
  padding: calc(22px * var(--scale)) 0;
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc({{ code_font_size }}px * var(--scale));
  line-height: 1.54;
  color: #E6EDF3;
  overflow: hidden;
}

.code-line {
  display: flex;
  align-items: flex-start;
  padding: calc(3px * var(--scale)) calc(28px * var(--scale));
  border-left: calc(5px * var(--scale)) solid transparent;
  white-space: pre-wrap;
  word-break: break-word;
}

.code-line.is-highlight {
  background: {{ theme.accent_color }}1A;
  border-left-color: {{ theme.accent_color }};
}

.code-line.is-diff-add {
  background: rgba(46, 184, 75, 0.18);
  border-left-color: #48DF76;
}

.code-line.is-diff-del {
  background: rgba(244, 63, 94, 0.18);
  border-left-color: #FB7185;
}

.line-no {
  width: calc(48px * var(--scale));
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.30);
  text-align: right;
  padding-right: calc(20px * var(--scale));
  user-select: none;
}

.line-code {
  flex: 1;
  min-width: 0;
}

/* Syntax token palette (high-contrast dark editor) */
.tok-k { color: #FF7B72; font-weight: 600; }
.tok-s { color: #A5D6FF; }
.tok-c { color: #8B949E; font-style: italic; }
.tok-f { color: #D2A8FF; font-weight: 600; }
.tok-nb { color: #79C0FF; }
.tok-m { color: #FFA657; }
.tok-o { color: #FF7B72; }
.tok-d { color: #7EE787; }
.tok-add { color: #7EE787; font-weight: 600; }
.tok-del { color: #FFA198; }

.footer {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: calc(20px * var(--scale));
}

.pills {
  display: flex;
  align-items: center;
  gap: calc(16px * var(--scale));
  flex-wrap: wrap;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: calc(68px * var(--scale));
  padding: 0 calc(30px * var(--scale));
  border-radius: 999px;
  font-size: calc(26px * var(--scale));
  font-weight: 600;
  letter-spacing: -0.01em;
  white-space: nowrap;
}

.pill-glass {
  background: var(--pill-glass-bg);
  border: 1.5px solid var(--pill-glass-border);
  color: var(--text);
}

.pill-accent {
  background: var(--pill-accent-bg);
  color: var(--pill-accent-text);
  font-weight: 700;
  padding: 0 calc(34px * var(--scale));
  box-shadow: 0 8px 24px {{ theme.pill_accent_bg }}40;
}

.cli-pill {
  display: inline-flex;
  align-items: center;
  background: var(--cli-bg);
  border: 1.5px solid var(--cli-border);
  border-radius: 999px;
  padding: calc(16px * var(--scale)) calc(32px * var(--scale));
  font-family: '{{ theme.font_mono }}', monospace;
  font-size: calc(23px * var(--scale));
  font-weight: 500;
  color: var(--cli-text);
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.micro-note {
  font-size: calc(21px * var(--scale));
  font-weight: 700;
  letter-spacing: 0.085em;
  text-transform: uppercase;
  padding-left: 6px;
  color: {{ theme.accent_color if item.footnote_accent else theme.subtle_color }};
}

.watermark {
  position: absolute;
  z-index: 20;
  font-size: calc(24px * var(--scale));
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--subtle);
}
.wm-bottom-right { right: calc(84px * var(--scale)); bottom: calc(74px * var(--scale)); }
.wm-top-right { right: calc(84px * var(--scale)); top: calc(92px * var(--scale)); }
.wm-bottom-left { left: calc(84px * var(--scale)); bottom: calc(24px * var(--scale)); }
</style>
</head>
<body>
  <div class="canvas">
    <div class="ambient-glow"></div>

    <div class="inner">
      <div class="top-bar">
        <div class="num">{{ slide_number }}</div>
        <div class="layout-chip">&lt;/&gt; {{ code_lang }}</div>
      </div>
      <div class="divider"></div>
      {% if item.eyebrow %}
        <div class="eyebrow">{{ item.eyebrow }}</div>
      {% endif %}
      <div class="title">{{ item.title }}</div>
      {% if item.description %}
        <div class="desc">{{ item.description }}</div>
      {% endif %}

      <div class="code-stage">
        <div class="code-window">
          <div class="window-bar">
            <div class="window-dots">
              <span class="wdot wdot-r"></span>
              <span class="wdot wdot-y"></span>
              <span class="wdot wdot-g"></span>
            </div>
            <div class="window-filename">{{ code_filename }}</div>
            <div class="window-lang">{{ code_lang }}</div>
          </div>
          <div class="code-body">
            {% for line in code_lines %}
            <div class="code-line {{ line.css_class }}">
              {% if show_line_numbers %}
                <span class="line-no">{{ line.number }}</span>
              {% endif %}
              <span class="line-code">{{ line.html | safe }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="footer">
        {% if item.badges %}
        <div class="pills">
          {% for badge in item.badges %}
            <div class="pill pill-{{ badge.style.value }}">{{ badge.text }}</div>
          {% endfor %}
        </div>
        {% endif %}

        {% if item.command_or_url %}
          <div class="cli-pill">{{ item.command_or_url }}</div>
        {% endif %}

        {% if item.footnote %}
          <div class="micro-note">{{ item.footnote }}</div>
        {% endif %}
      </div>
    </div>

    {% if theme.watermark %}
      <div class="watermark wm-{{ theme.watermark_position.value }}">{{ theme.watermark }}</div>
    {% endif %}
  </div>
</body>
</html>
